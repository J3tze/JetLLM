# Copy this file to .env.deploy and customize for your VPS.

# GHCR image to deploy.
# Examples:
# - ghcr.io/your-user/jetllm:latest
# - ghcr.io/your-user/jetllm:v1.0.0
# - ghcr.io/your-user/jetllm:sha-abc1234
JETLLM_IMAGE=ghcr.io/your-user/jetllm:latest

# Host port that maps to container port 3000.
JETLLM_PORT=3000
